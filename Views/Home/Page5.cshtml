@{
    ViewData["Title"] = "Page 3";
}

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="Style.css">
   
</head>

<header>

    <h1 class="nomdusite"><strong>RFID WEBSITE</strong></h1>

</header>
<p> <br><br></p>

<body>
    
  

    <div class="text-center">
        <h1 class="display-4"><u>Méthode 3</u></h1>
        <p> <br><br></p>

        <h2> <strong>Veuillez choisir vos hyperparamétres</strong></h2>
        <p> <br><br> </p>

       


        <form method="post" action="/Home/ResultMethode3">
            <h5>Kernel</h5>
            <select name="selectedItem">
                <option value="option1">linear</option>
                <option value="option2">poly</option>
                <option value="option3">rbf</option>
                <option value="option4">sigmoid</option>
            </select>
            <p> <br><br> </p>

            <label for="hyperparameter5"><h5>C</h5> </label> <p> <br> </p>
            <input type="range" id="hyperparameter5" name="hyperparameter5" min="0.01" max="10" value="50">
            
            <p> <br><br> </p>
            

            <label for="hyperparameter6"><h5>Gamma</h5></label> <p> <br> </p>
            <input type="range" id="hyperparameter6" name="hyperparameter6" min="0.01" max="10" value="50">
            <p> <br><br></p>

            <label for="hyperparameter3"><h5>Degré</h5></label> <p> <br> </p>
            <input type="range" id="hyperparameter3" name="hyperparameter3" min="1" max="3" value="50">
            <p> <br><br></p>

            <label for="hyperparameter3"><h5>Coef</h5></label> <p> <br> </p>
            <input type="range" id="hyperparameter3" name="hyperparameter3" min="-1" max="1" value="50">
            <p> <br><br></p>

            <h5>Tolérance</h5>
            <select name="selectedItem">
                <option value="option1">1e-3</option>
                <option value="option2">1e-4</option>
                <option value="option3">1e-5</option>
            </select>

            <p> <br><br></p>
            <p> <button type="submit" onclick="window.location.href='@Url.Action("ResultMethode3", "Home")'">Enregistrer</button>
        </form>





        <p> <br><br><br> </p>

       <div class="btn">
            <!-- <input class="dropbtn" type="submit" name="envoi" value="Sauvegarder" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;"> -->


            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

