@{
    ViewData["Title"] = "Page 3";
}

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="Style.css">
   
</head>
<header>

    <h1 class="nomdusite"><strong>RFID WEBSITE</strong></h1>

</header>
<p> <br><br></p>

<body>
    
  

    <div class="text-center">
        <h1 class="display-4"><u>Méthode 1</u></h1>
        <p> <br><br></p>

        <h2> <strong>Veuillez choisir vos hyperparamétres</strong></h2>
        <p> <br><br> </p>

       


        <form asp-action="RFClassifier" method="post">
            <label for="hyperparameter1">Hyperparamètre 1 :</label>
            <input type="range" id="hyperparameter1" name="hyperparameter1" min="50" max="200" value="50">
            
            <p> <br><br> </p>
            

            <label for="hyperparameter2">Hyperparamètre 2 :</label>
            <input type="range" id="hyperparameter2" name="hyperparameter2" min="5" max="15" value="50">
            <p><br><br></p>
            <p> <button type="submit">Enregistrer</button>
        </form>

        <h3>Result: @Html.Raw(ViewBag.Result1)</h3>



        <p> <br><br><br> </p>

       <div class="btn">

           <input class="dropbtn" type="submit" name="envoi" value="Retour"  onclick="window.location.href='@Url.Action("Index", "Home")'" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;">
            
        </div>

        <p><br></p>
    </div>
       
        
</body>
