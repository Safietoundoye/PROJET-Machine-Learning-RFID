@{
    ViewData["Title"] = "Page 3";
}

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="~/Page4.css">
     <script src="~/js/site.js"></script>
</head>


<body>

    <header>

        <nav class="navbar4">
            <ul>
                <li>  <h1 class="nomdusite"><strong>RFID WEBSITE</strong></h1> </li>
              

            </ul>
        </nav>

    </header>

    <div class="text-center">
   <span class="animation-text"><h1 class="display-4"> <u>Logistic Regression</u></h1> </span>
        <p> <br><br></p>

        <h2> <strong>Veuillez choisir vos hyperparamétres</strong></h2>
        <p> <br><br> </p>

       
        

        <form asp-action="LRClassifier" method="post">
            <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Un paramètre de réglage (λ), parfois appelé paramètre de pénalité, contrôle la force du terme de pénalité dans la régression ridge et la régression lasso. Il s'agit essentiellement de la quantité de rétrécissement, où les valeurs des données sont rétrécies vers un point central, comme la moyenne"> <span class="animation-text">  <h5>Penalty</h5> </span> </span>
            <select name="selectedItem1">
   
            <option value="l1">l1</option>
            <option value="l2">l2</option>
            <option value="elasticnet">elasticnet</option>
            <option value="none">none</option>
          </select>

            <p> <br><br> </p> 


            <label for="hyperparameter1"> <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le paramètre C est inversement proportionnel à la force de régularisation appliquée au modèle. La régularisation vise à prévenir le surajustement (overfitting) en pénalisant les coefficients de régression pour éviter qu'ils prennent des valeurs trop grandes. Le paramètre C contrôle l'inverse de cette pénalité, où une valeur plus élevée de C correspond à une régularisation plus faible, permettant aux coefficients d'avoir des valeurs plus importantes"> <span class="animation-text"><h5>C</h5> </span> </span>  </label>
             <p> <br> </p > 
            <input type="range" id="rangeInput" name="hyperparameter1" min="0.01" max="10" step="0.01" value="0.01">
            <p id="selectedValue">0.01</p>
             <p> <br> </p>

            <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le solveur est un ensemble d'algorithmes utilisés pour prendre des décisions. Les algorithmes du solveur se composent de générateurs et de chercheurs. Les générateurs produisent des décisions potentielles, puis les chercheurs les examinent pour trouver la meilleure décision dans le délai imparti">
                <span class="animation-text"> <h5>Solver</h5> </span> </span>
            <select name="selectedItem2">
                <option value="newton-cg">newton-cg</option>
                <option value="lbfgs">lbfgs</option>
                <option value="liblinear">liblinear </option>
                <option value="sag">sag</option>
                <option value="saga">saga</option>
            </select>

            
            <p> <br><br></p>
            <p> <button type="submit" class="dropbtn" onclick="window.location.href='@Url.Action("ResultMethode2", "Home")'">Valider</button>
        </form>


       <div class="btn">
           
           <div class="button-container">
           <input class="dropbtn" type="submit" name="envoi" value="Retour"  onclick="window.location.href='@Url.Action("Index", "Home")'" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;">
          </div>
        </div>

       
    </div>

    <script>
        const rangeInput = document.getElementById('rangeInput');
        const selectedValue = document.getElementById('selectedValue');

        rangeInput.addEventListener('input', () => {
            selectedValue.textContent = rangeInput.value;
        });


        

   </script>

</body>
