@{
    ViewData["Title"] = "Page 3";
}

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="~/Page6.css">
   
</head>


<body>
    <header>

        <nav class="navbar5">
            <ul>
                <li> <h1 class="nomdusite"><strong>RFID WEBSITE</strong></h1></li>
               

            </ul>
        </nav>

    </header>
  

    <div class="text-center">
     <span class="animation-text"> <h1 class="display-4"><u>K NEAREST-NEIGHBORS</u></h1></span>
        <p> <br><br></p>

        <h2> <strong>Veuillez choisir vos hyperparamétres</strong></h2>
        <p> <br><br> </p>

       


        <form method="post" action="">


            <label for="hyperparameter5"> <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le paramètre n_neighbors (nombre de voisins) dans l'algorithme des k plus proches voisins (KNN) est un paramètre qui spécifie le nombre de voisins les plus proches à considérer lors de la classification ou de la prédiction d'une nouvelle observation"><span class="animation-text"><h5>N_neighbors</h5></span>  </span> </label> <p> <br> </p>
            <input type="range" id="hyperparameter5" name="hyperparameter5" min="1" max="10" value="50">

            <p> <br><br> </p>

            <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le paramètre metric (métrique) dans l'algorithme KNN est un paramètre qui spécifie la mesure de distance utilisée pour calculer la similarité entre les observations lors de la recherche des voisins les plus proches">
                <span class="animation-text"><h5>Metric</h5> </span>
            </span>
            <select name="selectedItem">
                <option value="option1">euclidean</option>
                <option value="option2">manhattan</option>
                <option value="option3">chebyshev</option>
               
            </select>
            <p> <br><br> </p>

            <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le paramètre weights dans l'algorithme KNN est un paramètre qui spécifie comment les voisins sont pris en compte lors du calcul de la prédiction pour une nouvelle observation.Il existe généralement deux options pour le paramètre weights : uniform et distance">
                    <span class="animation-text"><h5>Weights</h5> </span>
                </span>
            <select name="selectedItem">
                <option value="option1">uniform</option>
                <option value="option2">distance</option>
               
            </select>
            <p> <br><br> </p>

            <span class="info-tooltip" data-toggle="tooltip" data-placement="top" title="Le paramètre algorithm dans l'algorithme KNN est un paramètre qui spécifie l'algorithme utilisé pour trouver les k voisins les plus proches d'une nouvelle observation.Il existe généralement deux options courantes pour le paramètre algorithm : Brute-force et Ball Tree ou KD Tree ">
                        <span class="animation-text"><h5>Algorithm</h5> </span>
                    </span>
            <select name="selectedItem">
                <option value="option1">auto</option>
                <option value="option2">brute</option>
                <option value="option3">kd_tree</option>
                <option value="option3">ball_tree</option>
            </select>
            <p> <br><br></p>

            <p> <button type="submit" class="dropbtn" onclick="window.location.href='@Url.Action("ResultMethode4", "Home")'">Valider</button>
        </form>


      <div class="btn">
            
           
        <div class="button-container">
           <input class="dropbtn" type="submit" name="envoi" value="Retour"  onclick="window.location.href='@Url.Action("Index", "Home")'" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;">
        </div>
       </div>

        <p><br></p>
    </div>
       
        
</body>
