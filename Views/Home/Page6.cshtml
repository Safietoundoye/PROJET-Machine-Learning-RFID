@{
    ViewData["Title"] = "Page 3";
}

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="Style.css">
   
</head>

<header>

    <h1 class="nomdusite"><strong>RFID WEBSITE</strong></h1>

</header>
<p> <br><br></p>

<body>
    
  

    <div class="text-center">
        <h1 class="display-4"><u>K NEAREST-NEIGHBORS</u></h1>
        <p> <br><br></p>

        <h2> <strong>Veuillez choisir vos hyperparamétres</strong></h2>
        <p> <br><br> </p>

       


        <form asp-action="KNNClassifier" method="post">


            <label for="hyperparameter1"><h5>N_neighbors</h5> </label> <p> <br> </p>
            <input type="range" id="rangeInput" name="hyperparameter1" min="1" max="10" value="1">
            <p id="selectedValue">1</p>
            <p> <br><br> </p>

            <h5>Metric</h5>
            <select name="selectedItem1">
                <option value="euclidean">euclidean</option>
                <option value="manhattan">manhattan</option>
                <option value="chebyshev">chebyshev</option>
               
            </select>
            <p> <br><br> </p>

            <h5>Weights</h5>
            <select name="selectedItem2">
                <option value="uniform">uniform</option>
                <option value="distance">distance</option>
               
            </select>
            <p> <br><br> </p>

            <h5>Algorithm</h5>
            <select name="selectedItem3">
                <option value="auto">auto</option>
                <option value="brute">brute</option>
                <option value="kd_tree">kd_tree</option>
                <option value="ball_tree">ball_tree</option>
            </select>
            <p> <br><br></p>

            <p> <button type="submit" onclick="window.location.href='@Url.Action("ResultMethode4", "Home")'">Enregistrer</button>
        </form>





        <p> <br><br><br> </p>

       <div class="btn">
            <!-- <input class="dropbtn" type="submit" name="envoi" value="Sauvegarder" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;"> -->


            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

           <input class="dropbtn" type="submit" name="envoi" value="Retour"  onclick="window.location.href='@Url.Action("Index", "Home")'" style="width: 250px; height: 50px; font-size: 24px; padding: 10px;">
            
        </div>

        <p><br></p>
    </div>

    <script>
        const rangeInput = document.getElementById('rangeInput');
        const selectedValue = document.getElementById('selectedValue');

        rangeInput.addEventListener('input', () => {
            selectedValue.textContent = rangeInput.value;
        });
    </script>
        
</body>
